<UserControl x:Class="VikingClip.App.Pages.HotkeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28,22,28,20">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Hotkeys" Style="{StaticResource H1}" />
            <TextBlock Text="These work everywhere, including fullscreen games. Click a box and press the new combination." Style="{StaticResource Muted}" Margin="0,2,0,18" />
            <Border Style="{StaticResource Card}">
                <StackPanel x:Name="Rows" />
            </Border>
            <TextBlock x:Name="Problems" Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}" Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
