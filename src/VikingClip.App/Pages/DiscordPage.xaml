<UserControl x:Class="VikingClip.App.Pages.DiscordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28,22,28,20">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Discord" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,18"
                       Text="Each entry is a channel you can post to from the Alt+K panel. Clips are always kept on this PC too; a copy is compressed to fit the channel's upload limit." />

            <ItemsControl x:Name="ChannelList" />

            <Border Style="{StaticResource Card}" Margin="0,4,0,14">
                <StackPanel>
                    <TextBlock Text="Add a channel" Style="{StaticResource H2}" Margin="0,0,0,12" />
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,10,12">
                            <TextBlock Text="Name shown in the panel" Style="{StaticResource Label}" />
                            <TextBox x:Name="NewName" />
                        </StackPanel>
                        <StackPanel Margin="10,0,0,12">
                            <TextBlock Text="Server upload limit" Style="{StaticResource Label}" />
                            <ComboBox x:Name="NewLimit">
                                <ComboBoxItem Content="10 MB (no boost)" Tag="10" IsSelected="True" />
                                <ComboBoxItem Content="50 MB (boost level 2)" Tag="50" />
                                <ComboBoxItem Content="100 MB (boost level 3)" Tag="100" />
                                <ComboBoxItem Content="500 MB" Tag="500" />
                            </ComboBox>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="Webhook URL" Style="{StaticResource Label}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="NewUrl" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Add channel" Margin="8,0,0,0" Click="Add_Click" />
                    </Grid>
                    <TextBlock x:Name="AddStatus" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <Rectangle Style="{StaticResource HRule}" Margin="0,14,0,12" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                        <Run Text="How to get a webhook: in Discord, open the channel's settings → Integrations → Webhooks → New Webhook → Copy Webhook URL. For a private channel, make a channel only you (or the people you choose) can see and create the webhook there." /><LineBreak /><LineBreak />
                        <Run Text="Treat the URL like a password - anyone who has it can post to that channel. VikingClip stores it encrypted for your Windows account and it never leaves this PC except to Discord." />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
