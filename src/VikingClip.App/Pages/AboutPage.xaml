<UserControl x:Class="VikingClip.App.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28,22,28,20">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="About" Style="{StaticResource H1}" />
            <TextBlock Text="VikingClip - a clipping tool for us and our friends." Style="{StaticResource Muted}" Margin="0,2,0,18" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/Assets/icon.png" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Text="VikingClip" Style="{StaticResource H2}" />
                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CheckButton" Content="Check for updates" Click="Check_Click" />
                        <Button x:Name="RestartButton" Style="{StaticResource PrimaryButton}" Content="Restart to update" Margin="8,0,0,0" Visibility="Collapsed" Click="RestartUpdate_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Diagnostics" Style="{StaticResource H2}" Margin="0,0,0,8" />
                    <TextBlock x:Name="DiagText" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Open log folder" Click="Logs_Click" Margin="0,0,8,0" />
                        <Button Content="Copy diagnostics" Click="Copy_Click" Margin="0,0,8,0" />
                        <Button Content="Open settings file" Click="SettingsFile_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Project" Style="{StaticResource H2}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap">
                        <Run Text="Source code, issues and new versions live on GitHub. Anyone in the group can send a pull request; releases are built automatically from tags and every install updates itself." />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Open GitHub repository" Click="GitHub_Click" Margin="0,0,8,0" />
                        <Button Content="How to contribute" Click="Contribute_Click" />
                    </StackPanel>
                    <Rectangle Style="{StaticResource HRule}" Margin="0,14,0,12" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="VikingClip is free software under the GPL-3.0 license. It bundles FFmpeg (GPL build by BtbN) for capture and encoding, NAudio for audio, Vortice for DirectX access and Velopack for installation and updates." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
