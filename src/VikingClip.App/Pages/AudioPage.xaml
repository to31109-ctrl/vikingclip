<UserControl x:Class="VikingClip.App.Pages.AudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28,22,28,20">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Audio" Style="{StaticResource H1}" />
            <TextBlock Text="Clips get three audio tracks: a mix (what players use), desktop only, and mic only." Style="{StaticResource Muted}" Margin="0,2,0,18" />

            <Border x:Name="RestartBar" Style="{StaticResource CardFlat}" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed" BorderBrush="{StaticResource AccentBrush}">
                <Grid>
                    <TextBlock Text="Audio settings changed. Restart capture to apply them." Style="{StaticResource Body}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Restart capture" HorizontalAlignment="Right" Click="Restart_Click" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <CheckBox x:Name="DesktopOn" Content="Desktop audio (everything you hear)" Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
                        <TextBlock x:Name="DesktopStatus" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Volume" Style="{StaticResource Label}" Margin="0,12,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="DesktopGain" Minimum="0" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Gain_Changed" />
                        <TextBlock x:Name="DesktopGainText" Grid.Column="1" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <CheckBox x:Name="MicOn" Content="Microphone" Checked="Toggle_Changed" Unchecked="Toggle_Changed" />
                        <TextBlock x:Name="MicStatus" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Device" Style="{StaticResource Label}" Margin="0,12,0,4" />
                    <ComboBox x:Name="MicDevice" SelectionChanged="MicDevice_Changed" />
                    <TextBlock Text="Volume" Style="{StaticResource Label}" Margin="0,12,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="MicGain" Minimum="0" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Gain_Changed" />
                        <TextBlock x:Name="MicGainText" Grid.Column="1" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Sync" Style="{StaticResource H2}" />
                    <TextBlock Text="If audio runs ahead of the video in your clips, move this right; if it lags, move it left. Most PCs need 0." Style="{StaticResource Caption}" Margin="0,2,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="Offset" Minimum="-300" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="Offset_Changed" />
                        <TextBlock x:Name="OffsetText" Grid.Column="1" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
