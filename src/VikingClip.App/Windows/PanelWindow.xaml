<Window x:Class="VikingClip.App.Windows.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VikingClip" Style="{StaticResource DarkWindow}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" Focusable="True">
    <Window.Resources>
        <!-- Big action tile -->
        <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Width" Value="128" />
            <Setter Property="Height" Value="96" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3Brush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDimBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KeyHint" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="MinWidth" Value="20" />
        </Style>
        <Style x:Key="KeyHintText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- Destination row -->
        <Style x:Key="DestRow" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        </Style>
    </Window.Resources>

    <Border Width="430" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="10" Padding="18,14,18,14" SnapsToDevicePixels="True">
        <StackPanel>
            <!-- header -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="4" Background="{StaticResource AccentBrush}" Margin="0,0,8,0">
                        <TextBlock Text="V" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="12"
                                   Foreground="{StaticResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="VikingClip" Style="{StaticResource H2}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="ContextText" Grid.Column="1" Style="{StaticResource Caption}" Margin="14,0,8,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextAlignment="Right" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click" ToolTip="Close (Esc)" />
            </Grid>

            <!-- step 1: actions -->
            <StackPanel x:Name="ActionsStep">
                <UniformGrid Columns="3" HorizontalAlignment="Center">
                    <Button x:Name="ClipTile" Style="{StaticResource Tile}" Margin="0,0,6,0" Click="Clip_Click">
                        <StackPanel>
                            <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
                            <TextBlock x:Name="ClipLabel" Text="Clip last 45 s" Style="{StaticResource Body}" HorizontalAlignment="Center" />
                            <Border Style="{StaticResource KeyHint}" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="1" Style="{StaticResource KeyHintText}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RecordTile" Style="{StaticResource Tile}" Margin="3,0,3,0" Click="Record_Click">
                        <StackPanel>
                            <TextBlock x:Name="RecordGlyph" Text="&#xE7C8;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource RecordBrush}" Margin="0,0,0,8" />
                            <TextBlock x:Name="RecordLabel" Text="Record" Style="{StaticResource Body}" HorizontalAlignment="Center" />
                            <Border Style="{StaticResource KeyHint}" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="2" Style="{StaticResource KeyHintText}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ShotTile" Style="{StaticResource Tile}" Margin="6,0,0,0" Click="Screenshot_Click">
                        <StackPanel>
                            <TextBlock Text="&#xE722;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8" />
                            <TextBlock Text="Screenshot" Style="{StaticResource Body}" HorizontalAlignment="Center" />
                            <Border Style="{StaticResource KeyHint}" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="3" Style="{StaticResource KeyHintText}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </UniformGrid>
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,12,0,0" TextAlignment="Center" />
            </StackPanel>

            <!-- step 2: destination -->
            <StackPanel x:Name="DestinationStep" Visibility="Collapsed">
                <Grid Margin="0,0,0,10">
                    <TextBlock x:Name="DestTitle" Text="Save clip to" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource GhostButton}" Content="Back" HorizontalAlignment="Right" Click="Back_Click" />
                </Grid>
                <ItemsControl x:Name="DestList" />
                <CheckBox x:Name="RememberBox" Content="Remember my choice and skip this step" Margin="2,6,0,0" FontSize="12" />
            </StackPanel>

            <!-- footer -->
            <Grid Margin="0,14,0,0">
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                    <Run Text="Esc" FontFamily="{StaticResource MonoFont}" /><Run Text=" closes · keys 1-3 pick" />
                </TextBlock>
                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="8,4" Click="Settings_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="Settings" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
