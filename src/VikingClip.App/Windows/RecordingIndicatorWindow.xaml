<Window x:Class="VikingClip.App.Windows.RecordingIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VikingClip" Style="{StaticResource DarkWindow}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" IsHitTestVisible="False">
    <Border Background="{StaticResource OverlayBrush}" CornerRadius="6" Padding="10,5" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{StaticResource RecordBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="TimeText" Text="REC 0:00" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
