<Window x:Class="VikingClip.App.Windows.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VikingClip" Style="{StaticResource DarkWindow}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="Height" Width="340" WindowStartupLocation="Manual" Cursor="Hand">
    <Border x:Name="Root" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True" MouseLeftButtonUp="Root_Click">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Bar" Background="{StaticResource AccentBrush}" CornerRadius="8,0,0,8" />
            <StackPanel Grid.Column="1" Margin="14,10,10,10">
                <TextBlock x:Name="TitleText" Style="{StaticResource Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DetailText" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="ProgressBarEl" Margin="0,8,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="Glyph" Grid.Column="2" Style="{StaticResource Icon}" Margin="0,0,14,0" Text="&#xE73E;" Foreground="{StaticResource AccentBrush}" />
        </Grid>
    </Border>
</Window>
