<Window x:Class="VikingClip.App.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:VikingClip.App.Pages"
        Title="VikingClip" Style="{StaticResource DarkWindow}"
        Width="1080" Height="720" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" CornerRadius="6" Margin="0,0,10,0" ClipToBounds="True">
                            <Border.Background>
                                <ImageBrush ImageSource="pack://application:,,,/Assets/icon.png" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <TextBlock Text="VikingClip" Style="{StaticResource H2}" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2,14,0,0">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource TextFaintBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText" Text="Starting…" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="18,10,18,16">
                    <TextBlock x:Name="VersionText" Text="v0.1.0" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="UpdateText" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed"
                               Cursor="Hand" MouseLeftButtonUp="UpdateText_Click" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Margin="0,4,0,0">
                    <RadioButton x:Name="NavLibrary" Style="{StaticResource NavItem}" Tag="&#xE714;" Content="Library" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavDiscord" Style="{StaticResource NavItem}" Tag="&#xE8BD;" Content="Discord" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavCapture" Style="{StaticResource NavItem}" Tag="&#xE7F4;" Content="Capture" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAudio" Style="{StaticResource NavItem}" Tag="&#xE720;" Content="Audio" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavHotkeys" Style="{StaticResource NavItem}" Tag="&#xE765;" Content="Hotkeys" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavStorage" Style="{StaticResource NavItem}" Tag="&#xE8B7;" Content="Storage &amp; games" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="&#xE946;" Content="About" Checked="Nav_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <pages:LibraryPage x:Name="LibraryPage" />
            <pages:DiscordPage x:Name="DiscordPage" Visibility="Collapsed" />
            <pages:CapturePage x:Name="CapturePage" Visibility="Collapsed" />
            <pages:AudioPage x:Name="AudioPage" Visibility="Collapsed" />
            <pages:HotkeysPage x:Name="HotkeysPage" Visibility="Collapsed" />
            <pages:StoragePage x:Name="StoragePage" Visibility="Collapsed" />
            <pages:AboutPage x:Name="AboutPage" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
