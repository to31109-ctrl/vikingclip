<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>VikingClip.App</RootNamespace>
    <AssemblyName>VikingClip</AssemblyName>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>VikingClip.App.Program</StartupObject>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <Description>Clip the last moments of your game, record, or screenshot - and drop it in Discord.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VikingClip.Core\VikingClip.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled ffmpeg (downloaded by tools\get-ffmpeg.ps1; never committed). -->
    <Content Include="ffmpeg\ffmpeg.exe" Condition="Exists('ffmpeg\ffmpeg.exe')" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ffmpeg\LICENSE.txt" Condition="Exists('ffmpeg\LICENSE.txt')" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="..\..\assets\icon.ico" Link="Assets\icon.ico" />
    <Resource Include="..\..\assets\icon.png" Link="Assets\icon.png" />
  </ItemGroup>

</Project>
